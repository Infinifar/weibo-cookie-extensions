{
  "manifest_version": 3,
  "name": "微博 Cookie 同步到青龙",
  "version": "1.0.0",
  "description": "读取当前微博登录账号的 Cookie，并按 UID 合并同步到青龙环境变量。",
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://weibo.com/*",
    "https://*.weibo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "微博 Cookie 同步",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://weibo.com/*",
        "https://*.weibo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.svg"
  }
}
